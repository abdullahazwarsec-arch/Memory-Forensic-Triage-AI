venv/
__pycache__/
*.pyc
Obfuscated-MalMem2022.csv
*.pdf
.vscode/

# Generated evidence workspaces (contain evidence copies and case data)
outputs/extracted/
outputs/cases/

# Microsoft Office lock files
~$*

# Hash sidecars of generated reports (the PDFs themselves are not committed)
outputs/*.pdf.sha256

# Secret custody-ledger HMAC key (generated on first run; never commit or share)
keys/

# Live audit log and its keyed head file (local evidence records, not source code)
logs/*.log
logs/*.head

# Archived audit logs (local evidence records)
logs/archive/
logs/*.lock
