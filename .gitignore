# ── Python / tooling ─────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.vscode/
.idea/

# ── Dataset (large; download separately - see README) ────────────────────────
data/Obfuscated-MalMem2022.csv

# ── Secrets: custody-ledger HMAC key and the account store ───────────────────
# Generated on first run. Never commit or share.
keys/

# ── Local evidence records (never public) ────────────────────────────────────
# Everything the dashboard generates: cases, evidence copies, extractions,
# sealed PDF reports and their .sha256 sidecars.
outputs/*
!outputs/.gitkeep

# Live audit log, its keyed head/lock files and archived logs
logs/*
!logs/.gitkeep

# ── Office lock files ────────────────────────────────────────────────────────
~$*
